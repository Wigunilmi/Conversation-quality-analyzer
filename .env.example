# Organizers' GET link from the Student Guide, page 3, WITHOUT the group_id parameter
CQA_API_URL=
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to use the offline MOCK evaluator.
LLM_BASE_URL=https://api.openai.com/v1
# Meta: LLM_BASE_URL=https://api.meta.ai/v1  LLM_MODEL=muse-spark-1.3  LLM_PRICE_IN=1.25  LLM_PRICE_OUT=4.25
# Gemini (free key from aistudio.google.com): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  and  LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# USD per 1M tokens, used for the cost-per-evaluation estimate
LLM_PRICE_IN=0.40
LLM_PRICE_OUT=1.60
PORT=3000
LLM_CONCURRENCY=4
# Run N judges and take the majority (more accurate, N× cost). 1 = off
LLM_VOTES=1
# Team-labeled examples added to the prompt (calibration). 0 = off
LLM_FEWSHOT=2
